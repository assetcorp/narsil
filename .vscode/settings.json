{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports": "never",
    "source.fixAll": "never"
  },
  "[javascript][javascriptreact][typescript][typescriptreact][json][css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "files.associations": {
    "**/packages/native/**/*.h": "c"
  },
  "clangd.path": "${workspaceFolder}/packages/native/.lint-tools/bin/clangd",
  "eslint.enable": false,
  "prettier.enable": false,
  "search.exclude": {
    "**/.archive": true
  },
  "vitest.rootConfig": "./packages/ts/vitest.config.ts",
  "vitest.runtime": "node",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
