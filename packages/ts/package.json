{
  "name": "@delali/narsil",
  "version": "0.3.0",
  "type": "module",
  "description": "Distributed search engine with full-text, vector, hybrid, and geosearch. One engine, embedded or on a server, with a cross-language .nrsl format.",
  "author": "Delali (https://sondelali.com)",
  "license": "Apache-2.0",
  "homepage": "https://narsil.sondelali.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/assetcorp/narsil.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "url": "https://github.com/assetcorp/narsil/issues"
  },
  "imports": {
    "#platform/worker-factory": {
      "browser": "./src/workers/factory.browser.ts",
      "default": "./src/workers/factory.ts"
    },
    "#platform/vector-promoter": {
      "browser": "./src/vector/promoter.browser.ts",
      "default": "./src/vector/promoter.ts"
    },
    "#platform/durable-fs": {
      "browser": "./src/persistence/durability/node-fs.browser.ts",
      "default": "./src/persistence/durability/node-fs.ts"
    },
    "#platform/lock-holder": {
      "browser": "./src/persistence/durability/lock-holder.browser.ts",
      "default": "./src/persistence/durability/lock-holder.ts"
    },
    "#platform/node-worker": {
      "browser": "./src/workers/node-worker.browser.ts",
      "default": "./src/workers/node-worker.ts"
    },
    "#platform/heap-statistics": {
      "browser": "./src/runtime/heap-statistics.browser.ts",
      "default": "./src/runtime/heap-statistics.ts"
    },
    "#platform/process-limit": {
      "browser": "./src/runtime/process-limit.browser.ts",
      "default": "./src/runtime/process-limit.ts"
    },
    "#platform/idle-heap-cleanup": {
      "browser": "./src/runtime/idle-heap-cleanup.browser.ts",
      "default": "./src/runtime/idle-heap-cleanup.ts"
    },
    "#platform/vector-file": {
      "browser": "./src/vector/vector-store/vector-file.browser.ts",
      "default": "./src/vector/vector-store/vector-file.ts"
    },
    "#platform/native-core": {
      "browser": "./src/vector/native/loader.browser.ts",
      "default": "./src/vector/native/loader.ts"
    },
    "#platform/search-backend-settings": {
      "browser": "./src/engine/search-backend-settings.browser.ts",
      "default": "./src/engine/search-backend-settings.ts"
    },
    "#platform/native-crc32": {
      "browser": "./src/serialization/native-crc32.browser.ts",
      "default": "./src/serialization/native-crc32.ts"
    },
    "#platform/pattern-search": {
      "browser": "./src/core/pattern-index/platform.browser.ts",
      "default": "./src/core/pattern-index/platform.ts"
    },
    "#platform/partial-word-search": {
      "browser": "./src/core/partition/partial-words/platform.browser.ts",
      "default": "./src/core/partition/partial-words/platform.ts"
    },
    "#platform/synonym-search": {
      "browser": "./src/core/synonyms/platform.browser.ts",
      "default": "./src/core/synonyms/platform.ts"
    }
  },
  "sideEffects": false,
  "keywords": [
    "search",
    "full-text-search",
    "search-engine",
    "indexing",
    "text-search",
    "distributed",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/check-browser-bundle.mjs && tsx scripts/api-surface.ts",
    "build:code": "rm -rf dist && NARSIL_BUILD_CODE_ONLY=1 tsup",
    "test": "vitest run --exclude='**/vector/recall.test.ts' --exclude='**/e2e/cluster-memory/**' --exclude='**/e2e/cluster-faults/**' --exclude='**/frozen-removal-memory/container-removes.test.ts'",
    "test:presubmit": "node scripts/check-postsubmit-list.mjs lists && vitest run --config vitest.presubmit.config.ts --reporter=default --reporter=json --outputFile.json=node_modules/.cache/narsil-presubmit-tests.json && node scripts/check-postsubmit-list.mjs presubmit node_modules/.cache/narsil-presubmit-tests.json",
    "test:postsubmit": "pnpm run test --reporter=default --reporter=json --outputFile.json=node_modules/.cache/narsil-postsubmit-tests.json",
    "test:postsubmit-times": "node scripts/check-postsubmit-list.mjs postsubmit node_modules/.cache/narsil-postsubmit-tests.json",
    "test:native": "vitest run src/__tests__/vector/native src/__tests__/integration/filtered-vector-recall/native src/__tests__/integration/filtered-vectors/mutations-native src/__tests__/integration/removed-vectors/main-thread",
    "test:cluster": "vitest run src/__tests__/e2e/cluster-memory --no-file-parallelism",
    "test:faults": "vitest run src/__tests__/e2e/cluster-faults --no-file-parallelism",
    "test:etcd": "vitest run src/__tests__/distribution/coordinator/etcd-integration/*.test.ts",
    "test:container-memory": "vitest run src/__tests__/e2e/frozen-removal-memory/container-removes.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:recall": "vitest run src/__tests__/vector/recall.test.ts",
    "test:embeddings": "NARSIL_TEST_EMBEDDINGS=1 vitest run embedding-e2e",
    "bench": "vitest bench",
    "stemmers": "tsx snowball/build.ts",
    "revisions": "tsx scripts/analysis-revisions.ts",
    "revisions:write": "tsx scripts/analysis-revisions.ts --write",
    "revisions:record": "tsx scripts/analysis-revisions.ts --record",
    "api": "tsx scripts/api-surface.ts",
    "api:write": "tsx scripts/api-surface.ts --write",
    "bundle-size:write": "rm -rf dist && tsup && node scripts/check-browser-bundle.mjs --update-baseline",
    "lookalikes": "tsx scripts/lookalike-counts.ts",
    "lookalikes:collect": "tsx scripts/lookalike-counts.ts --collect",
    "fold-table": "tsx scripts/fold-table.ts",
    "fold-table:write": "tsx scripts/fold-table.ts --write",
    "lint": "biome check src/",
    "typecheck:src": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:tooling": "tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p benchmarks/tsconfig.json && tsc --noEmit -p wasm/tsconfig.json && tsc --noEmit -p snowball/tsconfig.json",
    "typecheck": "pnpm run typecheck:src && pnpm run typecheck:tests && pnpm run typecheck:tooling"
  },
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/index.browser.mjs",
        "types": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./adapters/memory": {
      "import": "./dist/adapters/memory.mjs",
      "types": "./dist/adapters/memory.d.ts"
    },
    "./adapters/filesystem": {
      "import": "./dist/adapters/filesystem.mjs",
      "types": "./dist/adapters/filesystem.d.ts"
    },
    "./adapters/indexeddb": {
      "import": "./dist/adapters/indexeddb.mjs",
      "types": "./dist/adapters/indexeddb.d.ts"
    },
    "./invalidation/noop": {
      "import": "./dist/invalidation/noop.mjs",
      "types": "./dist/invalidation/noop.d.ts"
    },
    "./invalidation/filesystem": {
      "import": "./dist/invalidation/filesystem.mjs",
      "types": "./dist/invalidation/filesystem.d.ts"
    },
    "./invalidation/broadcast-channel": {
      "import": "./dist/invalidation/broadcast-channel.mjs",
      "types": "./dist/invalidation/broadcast-channel.d.ts"
    },
    "./vector/search-worker": {
      "import": "./dist/vector/search-worker.mjs",
      "types": "./dist/vector/search-worker.d.ts"
    },
    "./embeddings/openai": {
      "import": "./dist/embeddings/openai.mjs",
      "types": "./dist/embeddings/openai.d.ts"
    },
    "./rerankers/http": {
      "import": "./dist/rerankers/http.mjs",
      "types": "./dist/rerankers/http.d.ts"
    },
    "./pattern": {
      "import": "./dist/pattern.mjs",
      "types": "./dist/pattern.d.ts"
    },
    "./partial-words": {
      "import": "./dist/partial-words.mjs",
      "types": "./dist/partial-words.d.ts"
    },
    "./synonyms": {
      "import": "./dist/synonyms.mjs",
      "types": "./dist/synonyms.d.ts"
    },
    "./languages/*": {
      "import": "./dist/languages/*.mjs",
      "types": "./dist/languages/*.d.ts"
    },
    "./distribution": {
      "import": "./dist/distribution.mjs",
      "types": "./dist/distribution.d.ts"
    },
    "./distribution/coordinator/in-memory": {
      "import": "./dist/distribution/coordinator/in-memory.mjs",
      "types": "./dist/distribution/coordinator/in-memory.d.ts"
    },
    "./distribution/coordinator/etcd": {
      "import": "./dist/distribution/coordinator/etcd.mjs",
      "types": "./dist/distribution/coordinator/etcd.d.ts"
    },
    "./distribution/transport/tcp": {
      "import": "./dist/distribution/transport/tcp.mjs",
      "types": "./dist/distribution/transport/tcp.d.ts"
    },
    "./distribution/transport/in-memory": {
      "import": "./dist/distribution/transport/in-memory.mjs",
      "types": "./dist/distribution/transport/in-memory.d.ts"
    },
    "./distribution/transport/grpc": {
      "import": "./dist/distribution/transport/grpc.mjs",
      "types": "./dist/distribution/transport/grpc.d.ts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "types": "./dist/server.d.ts"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "types": "./dist/client.d.ts"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "types": "./dist/react.d.ts"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@msgpack/msgpack": "3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@delali/narsil-embeddings-transformers": "workspace:*",
    "@grpc/grpc-js": "1.14.4",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "22.15.32",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "0.28.2",
    "etcd3": "1.1.2",
    "fflate": "0.8.3",
    "jsdom": "28.1.0",
    "re2-wasm": "1.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "selfsigned": "5.5.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#ba110e817908b56c61d625b02f367b4ec9cfc8ab",
    "vitest": "4.0.18",
    "wabt": "1.0.39"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "1.14.4",
    "etcd3": "1.1.2",
    "react": ">=19.2.0",
    "uWebSockets.js": ">=20.0.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {
      "optional": true
    },
    "etcd3": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "uWebSockets.js": {
      "optional": true
    }
  }
}
