  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/check-browser-bundle.mjs && node scripts/check-vector-chunk.mjs && tsx scripts/api-surface.ts",
    "build:code": "rm -rf dist && NARSIL_BUILD_CODE_ONLY=1 tsup",
    "build:types": "NARSIL_BUILD_TYPES_ONLY=1 tsup",
    "test": "vitest run --exclude='**/vector/recall.test.ts' --exclude='**/vector/id-table-limit.test.ts' --exclude='**/e2e/cluster-memory/**' --exclude='**/e2e/cluster-faults/**' --exclude='**/frozen-removal-memory/container-removes.test.ts' --exclude='**/persistence/live-object-stores/**'",
    "test:object-stores": "vitest run src/__tests__/persistence/live-object-stores",
    "test:native": "vitest run src/__tests__/core/tokenizer src/__tests__/core/keyword-score src/__tests__/math src/__tests__/vector/native src/__tests__/integration/filtered-vector-recall/native src/__tests__/integration/filtered-vectors/mutations-native src/__tests__/integration/removed-vectors/main-thread src/__tests__/integration/sort-value-reduction.test.ts src/__tests__/integration/hybrid-fusion-extreme-scores.test.ts",
    "test:cluster": "vitest run src/__tests__/e2e/cluster-memory --no-file-parallelism",
    "test:faults": "vitest run src/__tests__/e2e/cluster-faults --no-file-parallelism",
    "test:etcd": "vitest run src/__tests__/distribution/coordinator/etcd-integration/*.test.ts",
    "test:container-memory": "vitest run src/__tests__/e2e/frozen-removal-memory/container-removes.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:recall": "vitest run src/__tests__/vector/recall.test.ts",
    "test:id-table-limit": "vitest run src/__tests__/vector/id-table-limit.test.ts",
    "test:embeddings": "NARSIL_TEST_EMBEDDINGS=1 vitest run embedding-e2e",
    "bench": "vitest bench",
    "stemmers": "tsx snowball/build.ts",
    "revisions": "tsx scripts/analysis-revisions.ts",
    "revisions:write": "tsx scripts/analysis-revisions.ts --write",
    "revisions:record": "tsx scripts/analysis-revisions.ts --record",
    "native-analysis": "tsx scripts/native-analysis/unicode.ts && tsx scripts/native-analysis/languages.ts",
    "native-analysis:write": "tsx scripts/native-analysis/unicode.ts --write && tsx scripts/native-analysis/languages.ts --write",
    "api": "tsx scripts/api-surface.ts",
    "api:write": "tsx scripts/api-surface.ts --write",
    "openapi": "tsx scripts/openapi/generate.ts",
    "openapi:write": "tsx scripts/openapi/generate.ts --write",
    "openapi:lint": "spectral lint openapi.json --ruleset .spectral.yaml --fail-severity error",
    "test:openapi-clients": "NARSIL_TEST_OPENAPI_CLIENTS=1 vitest run src/__tests__/server/openapi/generated-clients.test.ts",
    "bundle-size:write": "rm -rf dist && tsup && node scripts/check-browser-bundle.mjs --update-baseline",
    "lookalikes": "tsx scripts/lookalike-counts.ts",
    "lookalikes:collect": "tsx scripts/lookalike-counts.ts --collect",
    "fold-table": "tsx scripts/fold-table.ts",
    "fold-table:write": "tsx scripts/fold-table.ts --write",
    "lint": "biome check src/",
    "typecheck:src": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "typecheck:tooling": "tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p benchmarks/tsconfig.json && tsc --noEmit -p wasm/tsconfig.json && tsc --noEmit -p snowball/tsconfig.json",
    "typecheck": "pnpm run typecheck:src && pnpm run typecheck:tests && pnpm run typecheck:tooling"
  },
