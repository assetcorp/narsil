{
  "name": "narsil-ts",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run build",
        "cwd": "packages/ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run --exclude='**/vector/recall.test.ts'",
        "cwd": "packages/ts"
      }
    },
    "test:etcd": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run test:etcd",
        "cwd": "packages/ts"
      }
    },
    "stemmers": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run stemmers",
        "cwd": "packages/ts"
      }
    },
    "revisions": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run revisions",
        "cwd": "packages/ts"
      }
    },
    "revisions:write": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run revisions:write",
        "cwd": "packages/ts"
      }
    },
    "api": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run api",
        "cwd": "packages/ts"
      }
    },
    "api:write": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run api:write",
        "cwd": "packages/ts"
      }
    },
    "lookalikes": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run lookalikes",
        "cwd": "packages/ts"
      }
    },
    "fold-table": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run fold-table",
        "cwd": "packages/ts"
      }
    },
    "fold-table:write": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run fold-table:write",
        "cwd": "packages/ts"
      }
    },
    "lookalikes:collect": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "pnpm run lookalikes:collect",
        "cwd": "packages/ts"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run --coverage",
        "cwd": "packages/ts"
      }
    },
    "test:recall": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run src/__tests__/vector/recall.test.ts",
        "cwd": "packages/ts"
      }
    },
    "test:embeddings": {
      "executor": "nx:run-commands",
      "options": {
        "command": "NARSIL_TEST_EMBEDDINGS=1 pnpm vitest run embedding-e2e",
        "cwd": "packages/ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm biome check src/",
        "cwd": "packages/ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck",
        "cwd": "packages/ts"
      }
    },
    "typecheck:tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm run typecheck:tests",
        "cwd": "packages/ts"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish"
    }
  }
}
