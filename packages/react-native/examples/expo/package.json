{
  "name": "@delali/narsil-example-react-native-expo",
  "private": true,
  "version": "0.0.1",
  "description": "An Expo app that runs Narsil on a phone with no Babel or Metro settings and checks every answer.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@delali/narsil": "workspace:*",
    "@delali/narsil-react-native": "workspace:*",
    "expo": "58.0.21",
    "expo-file-system": "58.0.13",
    "expo-keep-awake": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "0.37.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.22",
    "typescript": "5.9.3"
  }
}
