from collections.abc import Callable, Iterable, Mapping
from os import PathLike
from types import TracebackType
from typing import Any, Self

from narsil._types import (
    BatchResult,
    Destination,
    Document,
    EventKind,
    ImportResult,
    IndexInfo,
    IndexStats,
    ListResult,
    MemoryStats,
    PartitionStats,
    PreflightResult,
    QueryResult,
    Settings,
    Source,
    SuggestResult,
    SyncStatus,
    VectorMaintenanceStatus,
)

VERSION: str

class MemoryPersistence:
    def __new__(cls) -> Self: ...

class FilesystemPersistence:
    def __new__(cls, directory: str | PathLike[str]) -> Self: ...

class StaleRebuild:
    @property
    def index_name(self) -> str: ...
    def __call__(self) -> None: ...

class GroupReducerHandle: ...

class QuerySuggestions:
    def record_query(self, index: str, query: Settings) -> dict[str, Any]: ...
    def update_setting(self, index: str, setting: Settings) -> None: ...
    def status(self, index: str) -> dict[str, Any]: ...
    def build(self, index: str) -> dict[str, Any]: ...
    def preview(self, index: str, limit: int | None = None) -> dict[str, Any]: ...
    def bans(self, index: str) -> list[str]: ...
    def update_bans(self, index: str, phrases: Iterable[str]) -> list[str]: ...
    def remove_query(self, index: str, query: str) -> int: ...
    def add_suggestion(self, index: str, suggestion: Settings) -> str: ...
    def suggestions_index_name(self, index: str, group: str) -> str: ...

class Narsil:
    def __new__(cls, config: Settings | None = None) -> Self: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exception_type: type[BaseException] | None,
        exception: BaseException | None,
        traceback: TracebackType | None,
    ) -> bool: ...
    @property
    def query_suggestions(self) -> QuerySuggestions: ...
    def create_index(self, name: str, config: Settings) -> None: ...
    def drop_index(self, name: str) -> None: ...
    def list_indexes(self) -> list[IndexInfo]: ...
    def open_index(self, name: str) -> None: ...
    def close_index(self, name: str) -> None: ...
    def shutdown(self) -> None: ...
    def insert(self, index: str, document: Mapping[str, Any], doc_id: str | None = None) -> str: ...
    def insert_batch(self, index: str, documents: Iterable[Mapping[str, Any]]) -> BatchResult: ...
    def update(self, index: str, doc_id: str, document: Mapping[str, Any]) -> None: ...
    def update_batch(self, index: str, updates: Iterable[Settings]) -> BatchResult: ...
    def remove(self, index: str, doc_id: str) -> None: ...
    def remove_batch(self, index: str, doc_ids: Iterable[str]) -> BatchResult: ...
    def get(self, index: str, doc_id: str) -> Document | None: ...
    def get_multiple(self, index: str, doc_ids: Iterable[str]) -> dict[str, Document]: ...
    def has(self, index: str, doc_id: str) -> bool: ...
    def count_documents(self, index: str) -> int: ...
    def clear(self, index: str) -> None: ...
    def wait_for_writes(self, index: str) -> None: ...
    def query(self, index: str, params: Settings) -> QueryResult: ...
    def preflight(self, index: str, params: Settings) -> PreflightResult: ...
    def suggest(self, index: str, params: Settings) -> SuggestResult: ...
    def list_documents(self, index: str, params: Settings | None = None) -> ListResult: ...
    def rebalance(self, index: str, target_partition_count: int) -> None: ...
    def change_analysis(self, index: str, change: Settings) -> None: ...
    def rebuild_analysis(self, index: str) -> None: ...
    def update_bm25(self, index: str, params: Settings) -> None: ...
    def update_partition_config(self, index: str, partitions: Settings) -> None: ...
    def update_synonyms(self, index: str, rules: Iterable[Settings]) -> None: ...
    def get_synonyms(self, index: str) -> list[dict[str, Any]]: ...
    def compact_vectors(self, index: str, field: str | None = None) -> None: ...
    def optimize_vectors(self, index: str, field: str | None = None) -> None: ...
    def vector_maintenance_status(self, index: str) -> list[VectorMaintenanceStatus]: ...
    def checkpoint(self, index: str) -> None: ...
    def update_sync(self, index: str, setting: Settings) -> None: ...
    def get_sync(self, index: str) -> SyncStatus: ...
    def get_stats(self, index: str) -> IndexStats: ...
    def get_partition_stats(self, index: str) -> list[PartitionStats]: ...
    def get_memory_stats(self) -> MemoryStats: ...
    def snapshot(self, index: str, destination: Destination = None, *, query_history: bool = False) -> bytes | None: ...
    def restore(self, index: str, source: Source) -> None: ...
    def export_documents(self, index: str, destination: Destination = None) -> bytes | None: ...
    def import_documents(self, index: str, source: Source) -> ImportResult: ...
    def on(self, kind: EventKind, listener: Callable[[dict[str, Any]], object]) -> int: ...
    def off(self, listener_id: int) -> bool: ...
    def register_tokenizer(self, name: str, tokenizer: Any) -> None: ...
    def register_stop_words(self, name: str, stop_words: Any) -> None: ...
    def register_embedding_adapter(self, name: str, adapter: Any) -> None: ...
    def register_rerank_adapter(self, name: str, adapter: Any) -> None: ...
    def add_plugin(self, plugin: Any) -> None: ...
